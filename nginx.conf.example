# ═══════════════════════════════════════════════════════════
#  Nginx config for insurops.tech on Hostinger VPS
#  Place at: /etc/nginx/sites-available/insurops
#  Enable:   sudo ln -s /etc/nginx/sites-available/insurops \
#                       /etc/nginx/sites-enabled/insurops
#  Test:     sudo nginx -t
#  Reload:   sudo systemctl reload nginx
# ═══════════════════════════════════════════════════════════

# Redirect HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name insurops.tech www.insurops.tech;

    # Let's Encrypt ACME challenge (certbot uses this)
    location /.well-known/acme-challenge/ { root /var/www/html; }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://insurops.tech$request_uri;
    }
}

# Redirect www → non-www (HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.insurops.tech;

    ssl_certificate     /etc/letsencrypt/live/insurops.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insurops.tech/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://insurops.tech$request_uri;
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name insurops.tech;

    ssl_certificate     /etc/letsencrypt/live/insurops.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insurops.tech/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options        "SAMEORIGIN"           always;
    add_header X-Content-Type-Options "nosniff"              always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy     "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Gzip
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json image/svg+xml;

    # Reverse-proxy to Node.js
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 30s;
    }

    # Block sensitive files from being served directly
    location ~ /\.(env|git|htaccess) { deny all; }
    location = /server.js             { deny all; }
    location = /package.json          { deny all; }
    location = /ecosystem.config.js   { deny all; }
}
